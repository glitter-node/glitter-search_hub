{
    "version": "1.0.0",
    "layout_name": "admin_search_hub",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:glitter-search_hub.admin.dashboard.title"
    },
    "data_sources": [
        {
            "id": "dashboard",
            "label_key": "$t:glitter-search_hub.admin.dashboard.title",
            "type": "api",
            "endpoint": "/api/modules/glitter-search_hub/admin/search-hub/dashboard",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "fallback": {
                "data": {
                    "providers": [],
                    "analytics": []
                }
            }
        }
    ],
    "permissions": [
        "glitter-search_hub.search_hub.read"
    ],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "gsh-page"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:glitter-search_hub.admin.dashboard.title",
                            "description": "$t:glitter-search_hub.admin.description"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Nav",
                        "props": {
                            "className": "gsh-nav",
                            "aria-label": "$t:glitter-search_hub.admin.navigation"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/dashboard",
                                    "aria-current": "{{route.path === '/admin/search-hub' || route.path === '/admin/search-hub/dashboard' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.dashboard.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/providers",
                                    "aria-current": "{{route.path === '/admin/search-hub/providers' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.providers.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/analytics",
                                    "aria-current": "{{route.path === '/admin/search-hub/analytics' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.analytics.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/diagnostics",
                                    "aria-current": "{{route.path === '/admin/search-hub/diagnostics' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.diagnostics.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/settings",
                                    "aria-current": "{{route.path === '/admin/search-hub/settings' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.settings.title"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Section",
                        "props": {
                            "className": "gsh-card"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H2",
                                "text": "$t:glitter-search_hub.admin.dashboard.available_providers"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "text": "{{(dashboard?.data?.providers ?? []).filter((provider) => provider.available).length}} / {{(dashboard?.data?.providers ?? []).length}}"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Section",
                        "props": {
                            "className": "gsh-card"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H2",
                                "text": "$t:glitter-search_hub.admin.dashboard.recent_activity"
                            },
                            {
                                "id": "dashboard_analytics_grid",
                                "type": "composite",
                                "name": "DataGrid",
                                "props": {
                                    "data": "{{dashboard?.data?.analytics ?? []}}",
                                    "pagination": false,
                                    "sortable": false,
                                    "emptyMessage": "$t:common.no_data",
                                    "columns": [
                                        {
                                            "field": "stat_date",
                                            "header": "$t:glitter-search_hub.analytics.date",
                                            "sortable": false,
                                            "required": true,
                                            "cellChildren": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{row.stat_date}}"
                                                }
                                            ]
                                        },
                                        {
                                            "field": "provider_key",
                                            "header": "$t:glitter-search_hub.analytics.provider",
                                            "sortable": false,
                                            "cellChildren": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{row.provider_key}}"
                                                }
                                            ]
                                        },
                                        {
                                            "field": "request_count",
                                            "header": "$t:glitter-search_hub.analytics.requests",
                                            "sortable": false,
                                            "cellChildren": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{row.request_count}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
