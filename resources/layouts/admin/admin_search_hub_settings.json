{
    "version": "1.0.0",
    "layout_name": "admin_search_hub_settings",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:glitter-search_hub.admin.settings.title"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:glitter-search_hub.editor.settings",
            "type": "api",
            "endpoint": "/api/modules/glitter-search_hub/admin/search-hub/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "fallback": {
                "data": {}
            }
        }
    ],
    "permissions": [
        "glitter-search_hub.search_hub.read"
    ],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "gsh-page"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:glitter-search_hub.admin.settings.title",
                            "description": "$t:glitter-search_hub.admin.description"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Nav",
                        "props": {
                            "className": "gsh-nav",
                            "aria-label": "$t:glitter-search_hub.admin.navigation"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/dashboard",
                                    "aria-current": "{{route.path === '/admin/search-hub/dashboard' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.dashboard.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/providers",
                                    "aria-current": "{{route.path === '/admin/search-hub/providers' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.providers.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/analytics",
                                    "aria-current": "{{route.path === '/admin/search-hub/analytics' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.analytics.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/diagnostics",
                                    "aria-current": "{{route.path === '/admin/search-hub/diagnostics' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.diagnostics.title"
                            },
                            {
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/search-hub/settings",
                                    "aria-current": "{{route.path === '/admin/search-hub/settings' ? 'page' : null}}"
                                },
                                "text": "$t:glitter-search_hub.admin.settings.title"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Section",
                        "props": {
                            "className": "gsh-card"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "P",
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:glitter-search_hub.settings.query_text_storage:"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{settings?.data?.query_text_storage === true}}",
                                        "text": "$t:glitter-search_hub.settings.enabled"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{settings?.data?.query_text_storage === false}}",
                                        "text": "$t:glitter-search_hub.settings.disabled"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:glitter-search_hub.settings.retention:"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{settings?.data?.automatic_analytics_retention === true}}",
                                        "text": "$t:glitter-search_hub.settings.enabled"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{settings?.data?.automatic_analytics_retention === false}}",
                                        "text": "$t:glitter-search_hub.settings.disabled"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
